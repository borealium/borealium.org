{
  "nodeModulesDir": "auto",
  "fmt": { "semiColons": false, "singleQuote": false, "useBraces": "always" },
  "tasks": {
    "check": "deno fmt --check . && deno lint . && deno check",
    "dev": "vite",
    "build": "vite build",
    "start": "deno serve -A _fresh/server.js",
    "update": "deno run -A -r jsr:@fresh/update ."
  },
  "lint": { "rules": { "tags": ["fresh", "recommended"] } },
  "exclude": ["**/_fresh/*"],
  "imports": {
    "@/": "./",
    "sass-embedded": "npm:sass-embedded@^1.100.0",
    "~types/": "./types/",
    "~data/": "./data/",
    "~lib/": "./lib/",
    "fresh": "jsr:@fresh/core@^2.3.3",
    "preact": "npm:preact@^10.29.1",
    "@divvun/keyboard": "jsr:@divvun/keyboard@^0.1.0",
    "@preact/signals": "npm:@preact/signals@^2.9.0",
    "@fresh/plugin-vite": "jsr:@fresh/plugin-vite@^1.1.2",
    "vite": "npm:vite@^7.3.6",
    "@fluent/bundle": "npm:@fluent/bundle@^0.18.0",
    "marked": "npm:marked@^12.0.2",
    "marked-highlight": "npm:marked-highlight@^2.2.4",
    "highlight.js": "npm:highlight.js@^11.11.1",
    "@std/fs": "jsr:@std/fs@^1.0.24",
    "@std/path": "jsr:@std/path@^1.1.6",
    "@std/toml": "jsr:@std/toml@^1.0.11",
    "d3": "npm:d3@^7.9.0",
    "cbor2": "npm:cbor2@^1.12.0"
  },
  "compilerOptions": {
    "lib": ["dom", "dom.asynciterable", "dom.iterable", "deno.ns"],
    "jsx": "precompile",
    "jsxImportSource": "preact",
    "jsxPrecompileSkipElements": [
      "a",
      "img",
      "source",
      "body",
      "html",
      "head",
      "title",
      "meta",
      "script",
      "link",
      "style",
      "base",
      "noscript",
      "template"
    ],
    "types": ["vite/client"]
  }
}
